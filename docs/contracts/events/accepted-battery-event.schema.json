{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tlcore:contracts:events:accepted-battery-event",
  "$ref": "urn:tlcore:contracts:event-envelope",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "const": "battery.level_reported"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "const": "device"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "battery_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["battery_percentage"],
      "additionalProperties": false
    }
  },
  "required": ["created_at"],
  "unevaluatedProperties": false
}
