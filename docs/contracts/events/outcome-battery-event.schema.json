{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tlcore:contracts:events:outcome-battery-event",
  "$ref": "urn:tlcore:contracts:event-envelope",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "const": "battery.workflow_outcome"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "device"
        }
      }
    },
    "original_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "battery_percentage": {
          "type": "integer",
          "maximum": 100,
          "minimum": 0
        },
        "classification": {
          "type": "string",
          "enum": ["critical", "low", "normal"]
        },
        "worker_state": {
          "type": "string",
          "enum": ["completed", "failed"]
        },
        "worker_outcome": {
          "type": "string",
          "enum": [
            "urgent_follow_up_completed",
            "routine_follow_up_completed",
            "no_action_required"
          ]
        },
        "failure_reason": {
          "type": "string",
          "const": "follow_up_failed"
        }
      },
      "oneOf": [
        {
          "properties": {
            "classification": {
              "type": "string",
              "const": "critical"
            },
            "battery_percentage": {
              "type": "integer",
              "maximum": 10,
              "minimum": 0
            },
            "worker_state": {
              "type": "string",
              "const": "completed"
            },
            "worker_outcome": {
              "type": "string",
              "const": "urgent_follow_up_completed"
            }
          },
          "required": ["worker_outcome"],
          "not": {
            "required": ["failure_reason"]
          }
        },
        {
          "properties": {
            "classification": {
              "type": "string",
              "const": "low"
            },
            "battery_percentage": {
              "type": "integer",
              "maximum": 20,
              "minimum": 11
            },
            "worker_state": {
              "type": "string",
              "const": "completed"
            },
            "worker_outcome": {
              "type": "string",
              "const": "routine_follow_up_completed"
            }
          },
          "required": ["worker_outcome"],
          "not": {
            "required": ["failure_reason"]
          }
        },
        {
          "properties": {
            "classification": {
              "type": "string",
              "const": "normal"
            },
            "battery_percentage": {
              "type": "integer",
              "maximum": 100,
              "minimum": 21
            },
            "worker_state": {
              "type": "string",
              "const": "completed"
            },
            "worker_outcome": {
              "type": "string",
              "const": "no_action_required"
            }
          },
          "required": ["worker_outcome"],
          "not": {
            "required": ["failure_reason"]
          }
        },
        {
          "properties": {
            "classification": {
              "type": "string",
              "const": "critical"
            },
            "battery_percentage": {
              "type": "integer",
              "maximum": 10,
              "minimum": 0
            },
            "worker_state": {
              "type": "string",
              "const": "failed"
            },
            "failure_reason": {
              "type": "string",
              "const": "follow_up_failed"
            }
          },
          "required": ["failure_reason"],
          "not": {
            "required": ["worker_outcome"]
          }
        },
        {
          "properties": {
            "classification": {
              "type": "string",
              "const": "low"
            },
            "battery_percentage": {
              "type": "integer",
              "maximum": 20,
              "minimum": 11
            },
            "worker_state": {
              "type": "string",
              "const": "failed"
            },
            "failure_reason": {
              "type": "string",
              "const": "follow_up_failed"
            }
          },
          "required": ["failure_reason"],
          "not": {
            "required": ["worker_outcome"]
          }
        },
        {
          "properties": {
            "classification": {
              "type": "string",
              "const": "normal"
            },
            "battery_percentage": {
              "type": "integer",
              "maximum": 100,
              "minimum": 21
            },
            "worker_state": {
              "type": "string",
              "const": "failed"
            },
            "failure_reason": {
              "type": "string",
              "const": "follow_up_failed"
            }
          },
          "required": ["failure_reason"],
          "not": {
            "required": ["worker_outcome"]
          }
        }
      ],
      "required": ["battery_percentage", "classification", "worker_state"],
      "additionalProperties": false
    }
  },
  "required": ["original_event_id", "created_at"],
  "unevaluatedProperties": false
}
