{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tlcore:contracts:events:classified-battery-event",
  "$ref": "urn:tlcore:contracts:event-envelope",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "const": "battery.classified"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "const": "device"
        }
      }
    },
    "original_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "battery_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "classification": {
          "type": "string",
          "enum": ["normal", "low", "critical"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "battery_percentage": {
              "type": "integer",
              "maximum": 100,
              "minimum": 21
            },
            "classification": {
              "const": "normal"
            }
          }
        },
        {
          "properties": {
            "battery_percentage": {
              "type": "integer",
              "maximum": 20,
              "minimum": 11
            },
            "classification": {
              "const": "low"
            }
          }
        },
        {
          "properties": {
            "battery_percentage": {
              "type": "integer",
              "maximum": 10,
              "minimum": 0
            },
            "classification": {
              "const": "critical"
            }
          }
        }
      ],
      "required": ["battery_percentage", "classification"],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["original_event_id", "created_at"],
  "unevaluatedProperties": false
}
